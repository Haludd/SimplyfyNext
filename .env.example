# Runtime
SIMPLYNEXT_ENVIRONMENT=development
SIMPLYNEXT_HOST=0.0.0.0
# Railway injects PORT at runtime; PORT takes precedence over this local value.
SIMPLYNEXT_PORT=8000
SIMPLYNEXT_LOG_LEVEL=INFO
SIMPLYNEXT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Comma-separated hostnames accepted by TrustedHostMiddleware. Set exact Railway/custom
# hostnames in production; do not use '*' there.
SIMPLYNEXT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production hides diagnostics by default. If troubleshooting requires docs, enable them only
# with a dedicated operator bearer token; never reuse a client stream token.
SIMPLYNEXT_OPERATOR_DOCS_ENABLED=false
SIMPLYNEXT_OPERATOR_DOCS_TOKEN=
SIMPLYNEXT_OPERATOR_METRICS_TOKEN=
# Railway-only deployment setting; Railway also accepts this in the service Variables tab.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# Ephemeral GlossLattice sessions
SIMPLYNEXT_SESSION_TTL_SECONDS=300
SIMPLYNEXT_MAX_ACTIVE_SESSIONS=128
SIMPLYNEXT_MAX_SESSION_CREATIONS_PER_MINUTE_GLOBAL=60
SIMPLYNEXT_HTTP_MAX_BODY_BYTES=262144

# Frozen GlossLattice v1 transport and deployment-approved producer
SIMPLYNEXT_GLOSS_LATTICE_MAX_MESSAGE_BYTES=32768
SIMPLYNEXT_MAX_LATTICES_PER_SESSION=100
SIMPLYNEXT_MAX_LATTICES_PER_MINUTE=30
SIMPLYNEXT_MAX_LATTICES_PER_MINUTE_GLOBAL=120
SIMPLYNEXT_MAX_CONCURRENT_AGENT_RUNS=4
SIMPLYNEXT_AGENT_QUEUE_TIMEOUT_SECONDS=2
SIMPLYNEXT_LATTICE_WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
SIMPLYNEXT_LATTICE_CLASSIFIER_ID=temporal_classifier
SIMPLYNEXT_LATTICE_CLASSIFIER_VERSION=1.3.0
SIMPLYNEXT_LATTICE_CALIBRATION_VERSION=temperature_v2
SIMPLYNEXT_LATTICE_VOCABULARY_VERSION=sgsl_demo_v1

# Lattice confidence gating and optional deterministic caption assembly.
SIMPLYNEXT_RECOGNITION_LANGUAGE=asl
SIMPLYNEXT_CAPTION_TEMPLATES_PATH=
SIMPLYNEXT_MIN_RECOGNITION_CONFIDENCE=0.80
SIMPLYNEXT_MIN_RECOGNITION_MARGIN=0.15

# Optional Bedrock assembly. Disabled by default so local runs never spend money.
SIMPLYNEXT_BEDROCK_ENABLED=false
SIMPLYNEXT_BEDROCK_MODEL_ID=
SIMPLYNEXT_AWS_REGION=ap-southeast-1
# Required when Bedrock is enabled; this is an accountable team member, not a secret.
SIMPLYNEXT_BEDROCK_LEASE_OWNER=
# Local kill switch. Keep this below the hackathon account's US$20 revocation threshold.
SIMPLYNEXT_BEDROCK_SPEND_LIMIT_USD=5.00
# Update from the lease owner's latest account-level spend check before starting the app.
SIMPLYNEXT_BEDROCK_KNOWN_SPEND_USD=0.00
# Verify model pricing against AWS before the demo; global inference rates can differ.
SIMPLYNEXT_BEDROCK_INPUT_USD_PER_MILLION_TOKENS=1.10
SIMPLYNEXT_BEDROCK_OUTPUT_USD_PER_MILLION_TOKENS=5.50
SIMPLYNEXT_BEDROCK_CACHE_WRITE_USD_PER_MILLION_TOKENS=1.375
SIMPLYNEXT_BEDROCK_CACHE_READ_USD_PER_MILLION_TOKENS=0.11
SIMPLYNEXT_BEDROCK_PROMPT_CACHE_ENABLED=true
SIMPLYNEXT_BEDROCK_CONNECT_TIMEOUT_SECONDS=5
SIMPLYNEXT_BEDROCK_READ_TIMEOUT_SECONDS=30
SIMPLYNEXT_BEDROCK_TOTAL_MAX_ATTEMPTS=3

# Optional direct Anthropic Messages API assembly. Keep both hosted providers disabled
# unless the selected provider's credentials, pricing, and spend owner are verified.
SIMPLYNEXT_ANTHROPIC_ENABLED=false
SIMPLYNEXT_ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
SIMPLYNEXT_ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# Optional Anthropic workspace ID for keys shared across workspaces.
SIMPLYNEXT_ANTHROPIC_WORKSPACE_ID=
# Required when Anthropic is enabled; this is an accountable team member, not a secret.
SIMPLYNEXT_ANTHROPIC_LEASE_OWNER=
SIMPLYNEXT_ANTHROPIC_SPEND_LIMIT_USD=5.00
SIMPLYNEXT_ANTHROPIC_KNOWN_SPEND_USD=0.00
# Verify these four current rates before enabling direct API calls; no defaults are assumed.
SIMPLYNEXT_ANTHROPIC_INPUT_USD_PER_MILLION_TOKENS=
SIMPLYNEXT_ANTHROPIC_OUTPUT_USD_PER_MILLION_TOKENS=
SIMPLYNEXT_ANTHROPIC_CACHE_WRITE_USD_PER_MILLION_TOKENS=
SIMPLYNEXT_ANTHROPIC_CACHE_READ_USD_PER_MILLION_TOKENS=
SIMPLYNEXT_ANTHROPIC_PROMPT_CACHE_ENABLED=false
SIMPLYNEXT_ANTHROPIC_CONNECT_TIMEOUT_SECONDS=5
SIMPLYNEXT_ANTHROPIC_READ_TIMEOUT_SECONDS=60
SIMPLYNEXT_ANTHROPIC_TOTAL_MAX_ATTEMPTS=3
# Export this standard secret in the launch shell or sealed deployment secret store.
# ANTHROPIC_API_KEY=do-not-commit
SIMPLYNEXT_AGENT_MAX_REVISIONS=1
