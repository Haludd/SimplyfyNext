# Local-only Gemini diagnostic profile. Copy to the repository-root .env and
# add GEMINI_API_KEY there. Never commit the filled .env file.
SIMPLYNEXT_ENVIRONMENT=development
SIMPLYNEXT_HOST=127.0.0.1
SIMPLYNEXT_PORT=8000
SIMPLYNEXT_LOG_LEVEL=INFO
SIMPLYNEXT_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SIMPLYNEXT_ALLOWED_ORIGINS=http://localhost:8081
SIMPLYNEXT_RECOGNITION_LANGUAGE=asl

SIMPLYNEXT_BEDROCK_ENABLED=false
SIMPLYNEXT_ANTHROPIC_ENABLED=false
SIMPLYNEXT_GEMINI_ENABLED=true
SIMPLYNEXT_GEMINI_MODEL_ID=gemini-3.1-flash-lite
SIMPLYNEXT_GEMINI_LEASE_OWNER=development-test
SIMPLYNEXT_GEMINI_SPEND_LIMIT_USD=5.00
SIMPLYNEXT_GEMINI_KNOWN_SPEND_USD=0.00
# These zero rates are for temporary free-tier testing only. Recheck Gemini
# pricing and quotas before every test or deployment.
SIMPLYNEXT_GEMINI_INPUT_USD_PER_MILLION_TOKENS=0
SIMPLYNEXT_GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=0
SIMPLYNEXT_GEMINI_CACHE_WRITE_USD_PER_MILLION_TOKENS=0
SIMPLYNEXT_GEMINI_CACHE_READ_USD_PER_MILLION_TOKENS=0
SIMPLYNEXT_GEMINI_PROMPT_CACHE_ENABLED=false
SIMPLYNEXT_GEMINI_CONNECT_TIMEOUT_SECONDS=5
SIMPLYNEXT_GEMINI_READ_TIMEOUT_SECONDS=60
SIMPLYNEXT_GEMINI_TOTAL_MAX_ATTEMPTS=1

SIMPLYNEXT_WORD_POLICY_PATH=data/word_policy.json
SIMPLYNEXT_WORD_POLICY_ENFORCE_VOCABULARY=true
SIMPLYNEXT_WORD_POLICY_ENFORCE_SCORES=true
SIMPLYNEXT_AGENT_MAX_REVISIONS=1
