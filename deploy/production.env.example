# Fill placeholders in the hosting secret/configuration store. Never commit filled values.
# This first hosted-verification profile allows text + no-spend sign repair.
SIMPLYNEXT_ENVIRONMENT=production
SIMPLYNEXT_HOST=0.0.0.0
SIMPLYNEXT_LOG_LEVEL=INFO
# Include Railway's healthcheck hostname plus the exact public API hostname.
SIMPLYNEXT_ALLOWED_HOSTS=api.example.invalid,healthcheck.railway.app
SIMPLYNEXT_ALLOWED_ORIGINS=https://app.example.invalid
SIMPLYNEXT_OPERATOR_DOCS_ENABLED=false
# Inject a randomly generated 32-byte-or-longer dedicated secret through sealed variables.
# SIMPLYNEXT_OPERATOR_METRICS_TOKEN=<sealed-secret>
SIMPLYNEXT_RECOGNITION_LANGUAGE=asl
SIMPLYNEXT_HTTP_MAX_BODY_BYTES=16384
SIMPLYNEXT_HTTP_BODY_TIMEOUT_SECONDS=10
SIMPLYNEXT_WEBSOCKET_MAX_CONNECTIONS=400
SIMPLYNEXT_WEBSOCKET_CONNECTIONS_PER_MINUTE=60
SIMPLYNEXT_WEBSOCKET_CONNECTIONS_GLOBAL_PER_MINUTE=600
SIMPLYNEXT_MAX_CONCURRENT_AGENT_RUNS=4
SIMPLYNEXT_AGENT_QUEUE_TIMEOUT_SECONDS=2
SIMPLYNEXT_AGENT_MAX_REVISIONS=1
SIMPLYNEXT_ROOM_MAX_ACTIVE=100
SIMPLYNEXT_ROOM_MAX_MESSAGES=300
SIMPLYNEXT_ROOM_INVITE_SECONDS=600
SIMPLYNEXT_ROOM_IDLE_SECONDS=1800
SIMPLYNEXT_ROOM_ABSOLUTE_SECONDS=7200
SIMPLYNEXT_ROOM_INVITATIONS_PER_MINUTE=20
SIMPLYNEXT_ROOM_INVITATIONS_GLOBAL_PER_MINUTE=120
SIMPLYNEXT_ROOM_MESSAGES_PER_MINUTE=30
SIMPLYNEXT_ROOM_TRANSLATION_TIMEOUT_SECONDS=90
SIMPLYNEXT_CONTEXT_ASSEMBLER_TOKEN_BUDGET=8000
SIMPLYNEXT_CONTEXT_CRITIC_TOKEN_BUDGET=3000
SIMPLYNEXT_PROVIDER_REQUEST_SPEND_LIMIT_USD=0.50
SIMPLYNEXT_PROVIDER_ROOM_SPEND_LIMIT_USD=2.00
SIMPLYNEXT_PROVIDER_HOURLY_SPEND_LIMIT_USD=5.00
SIMPLYNEXT_PROVIDER_SPEND_JOURNAL_PATH=/app/spend/usage.json
SIMPLYNEXT_BEDROCK_ENABLED=false
SIMPLYNEXT_ANTHROPIC_ENABLED=false
SIMPLYNEXT_BEDROCK_TOTAL_MAX_ATTEMPTS=1
SIMPLYNEXT_ANTHROPIC_TOTAL_MAX_ATTEMPTS=1
SIMPLYNEXT_BEDROCK_PROMPT_CACHE_ENABLED=false
SIMPLYNEXT_ANTHROPIC_PROMPT_CACHE_ENABLED=false
# Paid mode additionally needs the reviewed policy + matching evaluation files, selected
# provider's owner/model/four verified prices/process ceiling/known spend, sealed credentials,
# and the persistent writable aggregate-only spend volume. See HOSTED_VERIFICATION.md.
